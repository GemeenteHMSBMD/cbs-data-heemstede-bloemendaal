{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/GemeenteHMSBMD/cbs-data-heemstede-bloemendaal/refs/heads/main/visualsdataBMD/VegaPyramideBMDtab.txt",
    "format": {
      "type": "tsv",
      "parse": {
        "jaar": "number",
        "mannen": "number",
        "vrouwen": "number",
        "leeftijd": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.jaar == jaar"
    },
    {
      "calculate": "-datum.mannen",
      "as": "_mannen"
    },
    {
      "calculate": "datum.jaar - datum.leeftijd",
      "as": "geboortejaar"
    },
    {
      "calculate": "datum.leeftijd > 99 ? datum.geboortejaar + ' en eerder' : datum.geboortejaar",
      "as": "_geboortejaartooltip"
    },
    {
      "calculate": "datum.leeftijd > 99 ? '+100' : datum.leeftijd",
      "as": "_leeftijdtooltip"
    },
    {
      "fold": ["_mannen", "vrouwen"],
      "as": ["geslacht", "aantal"]
    },
    {
      "calculate": "datum.geslacht == '_mannen' ? 'Mannen' : 'Vrouwen'",
      "as": "GeslachtLabel"
    },
    {
      "calculate": "abs(datum.aantal)",
      "as": "_aantalTooltip"
    }
  ],
  "encoding": {
    "y": {
      "field": "leeftijd",
      "type": "ordinal",
      "sort": "descending",
      "axis": {
        "title": "Leeftijd",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelExpr": "datum.value % 10 === 0 ? datum.value : ''"
      }
    },
"x": {
  "field": "aantal",
  "type": "quantitative",
  "axis": {
    "title": "Aantal personen",
    "format": ",d",
    "labelFont": "sans-serif",
    "labelFontWeight": "normal",
    "labelFontSize": 11,          // kleiner font
    "labelPadding": 2,            // dichter tegen de as
    "labelExpr": "abs(datum.value)"
  },
  "scale": { "domain": [-250, 250] }
}

,
    "color": {
      "field": "GeslachtLabel",
      "type": "nominal",
      "scale": {
        "domain": ["Mannen", "Vrouwen"],
        "range": ["#66c2a5", "#1b7837"]
      },
      "legend": {
        "title": "Geslacht",
        "orient": "top"
      }
    },
    "tooltip": [
      { "field": "_geboortejaartooltip", "title": "Geboortejaar" },
      { "field": "_leeftijdtooltip", "title": "Leeftijd" },
      { "field": "_aantalTooltip", "title": "Aantal" },
      { "field": "GeslachtLabel", "title": "Geslacht" }
    ]
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "params": [
    {
      "name": "jaar",
      "value": 1988,
      "bind": {
        "input": "range",
        "min": 1988,
        "max": 2024,
        "step": 1,
        "name": "Jaar: "
      }
    }
  ]
}
