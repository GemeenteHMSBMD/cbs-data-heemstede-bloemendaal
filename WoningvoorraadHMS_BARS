{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Woningvoorraad Heemstede: verdeling en totalen",
  "params": [
    {
      "name": "jaar",
      "value": 2012,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2025,
        "step": 1,
        "name": "Kies een jaar: "
      }
    }
  ],
  "vconcat": [
    {
      "width": 1000,
      "data": {
        "url": "https://raw.githubusercontent.com/GemeenteHMSBMD/cbs-data-heemstede-bloemendaal/main/WoningvoorraadCBS.txt",
        "format": { "type": "tsv" }
      },
      "transform": [
        {
          "filter": "datum.Gemeente === 'Heemstede' && datum.Jaar == jaar && datum.Oppervlakteklasse !== 'Totaal'"
        }
      ],
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "Oppervlakteklasse",
          "type": "ordinal",
          "sort": [
            "< 20", "20 tot 30", "30 tot 40", "40 tot 50", "50 tot 60",
            "60 tot 70", "70 tot 80", "80 tot 90", "90 tot 100",
            "100 tot 120", "120 tot 140", "140 tot 160", "160 en meer"
          ],
          "title": "Oppervlakteklasse (m²)",
          "axis": { "labelAngle": -40 }
        },
        "y": {
          "field": "Beginstand woningvoorraad",
          "type": "quantitative",
          "title": "Aantal woningen"
        },
        "color": {
          "field": "Woningtype",
          "type": "nominal",
          "title": "Woningtype",
          "scale": { "scheme": "dark2" }
        },
        "tooltip": [
          { "field": "Jaar" },
          { "field": "Woningtype" },
          { "field": "Oppervlakteklasse" },
          { "field": "Beginstand woningvoorraad" }
        ]
      }
    },
    {
      "width": 1000,
      "data": {
        "url": "https://raw.githubusercontent.com/GemeenteHMSBMD/cbs-data-heemstede-bloemendaal/main/WoningvoorraadCBS.txt",
        "format": { "type": "tsv" }
      },
      "transform": [
        {
          "filter": "datum.Gemeente === 'Heemstede' && datum.Jaar == jaar && datum.Oppervlakteklasse === 'Totaal'"
        }
      ],
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "Woningtype",
          "type": "nominal",
          "title": "Woningtype"
        },
        "y": {
          "field": "Beginstand woningvoorraad",
          "type": "quantitative",
          "title": "Totaal aantal woningen"
        },
        "color": {
          "field": "Woningtype",
          "type": "nominal",
          "scale": { "scheme": "dark2" },
          "title": "Woningtype"
        },
        "tooltip": [
          { "field": "Jaar" },
          { "field": "Woningtype" },
          { "field": "Beginstand woningvoorraad" }
        ]
      }
    }
  ]
}
